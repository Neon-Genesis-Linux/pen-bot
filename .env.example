ENV="staging"
BOT_TOKEN="your-bot-token"
GUILD_ID= #"123456789012345678" - uncomment to register commands to a single guild for faster dev/test updates

## DATABASE
# Where the SQLite database file lives. The parent directory is created if it
# does not exist. The container image sets this to /data/pen-bot.db.
DB_PATH="/data/pen-bot.db"
# Distinguishes instances that share one directory, so that two of them can
# run side by side without seeing each other's data. Each instance gets its
# own file. Ignored when DB_PATH is set.
DB_BOT_INSTANCE_ID="pen-bot-1"
# Size of the connection pool. SQLite serialises writes, so a small pool is
# enough.
DB_MAX_OPEN_CONNS="4"
DB_MAX_IDLE_CONNS="4"
DB_CONN_MAX_LIFETIME="30m"
DB_CACHE_CLEANUP_INTERVAL="15m"
